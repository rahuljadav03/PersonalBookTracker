<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalBookTracker">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PersonalBookTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Form Add/Edit Book Activity -->
        <activity
            android:name=".AddBookActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Book Library List Activity -->
        <activity
            android:name=".BookListActivity"
            android:exported="false" />

        <!-- Book Details Activity -->
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />

        <!-- Reading Statistics Activity -->
        <activity
            android:name=".StatisticsActivity"
            android:exported="false" />

    </application>

</manifest>