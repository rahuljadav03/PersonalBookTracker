<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_toast_message"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/bg_custom_toast"
    android:clickable="false"
    android:elevation="6dp"
    android:focusable="false"
    android:gravity="center"
    android:importantForAccessibility="yes"
    android:maxWidth="@dimen/toast_max_width"
    android:maxLines="3"
    android:paddingHorizontal="@dimen/toast_padding_horizontal"
    android:paddingVertical="@dimen/toast_padding_vertical"
    android:textColor="@color/toast_text_color"
    android:textSize="14sp" />